{
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=7.0.0"
  },
  "name": "voice_among_voices",
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "prebuild": "npm run extract-candid && npm run prebuild --workspaces --if-present",
    "pretest": "npm run prebuild --workspaces --if-present",
    "start": "npm start --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "dev": "npm run dev --workspaces --if-present",
    "dev-host": "npm run dev-host --workspaces --if-present",
    "extract-candid": "candid-extractor target/wasm32-unknown-unknown/release/voice_among_voices_backend.wasm > src/voice_among_voices_backend/voice_among_voices_backend.did"
  },
  "type": "module",
  "workspaces": [
    "src/voice_among_voices_frontend"
  ],
  "dependencies": {
    "@dfinity/agent": "^2.4.0",
    "@dfinity/auth-client": "^2.4.0",
    "@dfinity/candid": "^2.4.0",
    "@dfinity/identity": "^2.4.0",
    "@dfinity/principal": "^2.4.0",
    "@dimforge/rapier2d": "^0.14.0",
    "@dimforge/rapier2d-compat": "^0.14.0",
    "@reown/appkit": "^1.7.0",
    "@reown/appkit-adapter-wagmi": "^1.7.0",
    "@wagmi/connectors": "^5.7.4",
    "@wagmi/core": "^2.16.7",
    "extendable-media-recorder": "^9.2.11",
    "extendable-media-recorder-wav-encoder": "^7.0.115",
    "ic-siwe-js": "^0.2.4",
    "viem": "^2.23.13",
    "vite-plugin-top-level-await": "^1.4.4",
    "vite-plugin-wasm": "^3.3.0",
    "wagmi": "^2.14.15"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.5.26",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@tsconfig/svelte": "^5.0.4",
    "@types/node": "^22.10.2",
    "autoprefixer": "^10.4.20",
    "cross-fetch": "^4.0.0",
    "dotenv": "^16.4.5",
    "jsdom": "^25.0.0",
    "postcss": "^8.4.45",
    "sass": "^1.78.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.1",
    "svelte-preprocess": "^6.0.2",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.6.2",
    "vite": "^5.4.4",
    "vite-plugin-environment": "^1.1.3",
    "vitest": "^2.0.5"
  }
