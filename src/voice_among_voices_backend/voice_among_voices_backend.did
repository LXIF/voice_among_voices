type VoiceNodeIngress = record {
    x : float64;
    y : float64;
    sample : vec nat8;
};

type VoiceNodeEgress = record {
    id : nat64;
    x : float64;
    y : float64;
    radius : float64;
};

type AudioSample = record {
    id : nat64;
    sample : vec nat8;
    sample_length_ms : float64;
    sample_length_samples : nat32;
};

type SimulationParameters = record {
    velocity_cutoff : float64;
    force_cutoff : float64;
    max_distance : float64;
    force_strength : float64;
    linear_damping : float64;
    logical_width : float64;
    logical_height : float64;
    n_collider_vertices : nat64;
    friction : float64;
};

type AudioParameters = record {
    total_length_ms : nat32;
    max_sample_length_ms : nat32;
    sample_rate : nat32;
    chunk_size : nat64;
};

type ColliderCoordinate = record {
    x : float64;
    y : float64;
};

type VoiceNodeStoreEgress = vec VoiceNodeEgress;

type AddVoiceNodeResult = variant {
    Ok : VoiceNodeStoreEgress;
    Err : variant {
        NotWithinCircleError;
        NotValidAudioFileError : text;
    };
};

type StreamingCallbackToken = record {
    id : nat32;
    chunk_index : nat32;
    chunks : nat32;
    token : opt vec nat8;
};

type StreamingCallbackHttpResponse = record {
    body : vec nat8;
    token : opt StreamingCallbackToken;
};

type StreamingStrategy = variant {
    Callback : record {
        token : StreamingCallbackToken;
        callback : func(StreamingCallbackToken) -> (StreamingCallbackHttpResponse) query;
    };
};

type HttpStreamingResponse = record {
    status_code : nat16;
    headers : vec record { text; text };
    body : vec nat8;
    upgrade : opt bool;
    streaming_strategy : opt StreamingStrategy;
};

service : {
    "add_voice_node" : (VoiceNodeIngress) -> (AddVoiceNodeResult);
    "get_voice_nodes" : () -> (VoiceNodeStoreEgress) query;
    "get_simulation_parameters" : () -> (SimulationParameters) query;
    "get_audio_parameters" : () -> (AudioParameters) query;
    "get_collider_coordinates" : () -> (vec ColliderCoordinate) query;
    "get_my_voice" : () -> (opt AudioSample) query;
    "get_angle_file" : (float64) -> (HttpStreamingResponse) query;
    "http_request_streaming_callback" : (StreamingCallbackToken) -> (StreamingCallbackHttpResponse) query;
};
