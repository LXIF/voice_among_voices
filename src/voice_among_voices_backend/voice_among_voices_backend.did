type AddVoiceNodeError = variant {
  EvmError : text;
  SetupError : text;
  InvalidNodeId;
  Unauthorized;
  NotValidAudioFileError : text;
  NotWithinCircleError : text;
};
type AddressEgress = record { address : text };
type AudioParameters = record {
  fade_ms : nat32;
  sample_rate : nat32;
  max_sample_length_ms : nat32;
  total_length_ms : nat32;
  chunk_size : nat64;
};
type AudioSample = record {
  id : nat64;
  sample : blob;
  sample_length_samples : nat32;
  sample_length_ms : float64;
};
type AuthorizationError = variant {
  EvmError : text;
  SetupError : text;
  Unauthorized;
};
type CensorshipError = variant {
  EvmError : text;
  InternalCanisterError : text;
  SetupError : text;
  Unauthorized;
  VoiceNotFound;
};
type ColliderCoordinate = record { x : float64; y : float64 };
type HttpRequest = record {
  url : text;
  method : text;
  body : blob;
  headers : vec record { text; text };
  certificate_version : opt nat16;
};
type HttpResponse = record {
  body : blob;
  headers : vec record { text; text };
  upgrade : opt bool;
  status_code : nat16;
};
type HttpStreamingResponse = record {
  body : blob;
  headers : vec record { text; text };
  upgrade : opt bool;
  streaming_strategy : opt StreamingStrategy;
  status_code : nat16;
};
type Result = variant { Ok; Err : CensorshipError };
type Result_1 = variant { Ok : AudioSample; Err : CensorshipError };
type Result_2 = variant { Ok : vec VoiceNodeEgress; Err : text };
type Result_3 = variant { Ok : text; Err : text };
type Result_4 = variant { Ok; Err : AuthorizationError };
type Result_5 = variant { Ok : vec VoiceNodeEgress; Err : AddVoiceNodeError };
type SimulationParameters = record {
  logical_radius : float64;
  density : float64;
  velocity_cutoff : float64;
  n_collider_vertices : nat64;
  max_steps : nat64;
  force_cutoff : float64;
  friction : float64;
  force_strength : float64;
  max_distance : float64;
  linear_damping : float64;
};
type StorableConfig = record {
  admin_id : nat64;
  dev_mode : bool;
  token_buy_link : text;
};
type StreamingCallbackHttpResponse = record {
  token : opt StreamingCallbackToken;
  body : blob;
  headers : vec record { text; text };
};
type StreamingCallbackToken = record {
  chunk_index : nat32;
  angle : nat32;
  auth_token : opt blob;
  chunks : nat32;
};
type StreamingStrategy = variant {
  Callback : record {
    token : StreamingCallbackToken;
    callback : func (StreamingCallbackToken) -> (
        StreamingCallbackHttpResponse,
      ) query;
  };
};
type VoiceAction = variant { Drop; Censor };
type VoiceAmongVoicesInit = record {
  siwe_canister_principal : opt principal;
  token_address : opt text;
  dev_mode : opt bool;
  admin_token_id : opt nat64;
  token_buy_link : opt text;
};
type VoiceLog = record {
  id : nat64;
  action : VoiceAction;
  initiator : AddressEgress;
  timestamp : nat64;
  position : opt ColliderCoordinate;
};
type VoiceNodeEgress = record {
  x : float64;
  y : float64;
  id : nat64;
  radius : float64;
};
type VoiceNodeIngress = record {
  x : float64;
  y : float64;
  id : nat64;
  sample : blob;
};
service : (opt VoiceAmongVoicesInit) -> {
  censor : (nat64) -> (Result);
  generate_file_for_angle : (nat64) -> (HttpStreamingResponse);
  get_admin_id : () -> (nat64) query;
  get_angle_file : (nat64) -> (HttpStreamingResponse);
  get_audio_parameters : () -> (AudioParameters) query;
  get_collider_coordinates : () -> (vec ColliderCoordinate) query;
  get_config : () -> (StorableConfig) query;
  get_my_principal : () -> (text) query;
  get_simulation_parameters : () -> (SimulationParameters) query;
  get_siwe_principal : () -> (principal) query;
  get_token_address : () -> (AddressEgress) query;
  get_token_buy_link : () -> (text) query;
  get_voice : (nat64) -> (Result_1) query;
  get_voice_logs : (nat64, nat64) -> (vec VoiceLog) query;
  get_voice_nodes : () -> (Result_2) query;
  get_wallet_address : () -> (Result_3) composite_query;
  get_zero_file : () -> (HttpStreamingResponse) query;
  http_request : (HttpRequest) -> (HttpResponse) query;
  http_request_streaming_callback : (StreamingCallbackToken) -> (
      StreamingCallbackHttpResponse,
    ) query;
  populate_with_demo_content : () -> (Result_4);
  update_voice_node : (VoiceNodeIngress) -> (Result_5);
}
