{
  "name": "voice_among_voices_frontend",
  "private": true,
  "scripts": {
    "build": "tsc && vite build",
    "format": "prettier --write \"src/**/*.{json,js,jsx,ts,tsx,css,scss}\"",
    "prebuild": "dfx generate",
    "setup": "npm i && dfx canister create voice_among_voices_backend && dfx generate voice_among_voices_backend && dfx deploy",
    "start": "vite --port 3000",
    "test": "vitest run",
    "dev": "vite dev",
    "dev-host": "vite dev --host",
    "preview": "vite preview",
    "build-debug": "vite build --debug"
  },
  "type": "module",
  "version": "0.0.0",
  "dependencies": {
    "@dfinity/agent": "^2.4.0",
    "@dfinity/auth-client": "^2.4.0",
    "@dfinity/candid": "^2.4.0",
    "@dfinity/identity": "^2.4.0",
    "@dfinity/principal": "^2.4.0",
    "@dfinity/utils": "^2.13.0",
    "@dimforge/rapier2d": "^0.16.0",
    "@dimforge/rapier2d-compat": "^0.16.0",
    "@reown/appkit": "^1.7.3",
    "@reown/appkit-adapter-wagmi": "^1.7.3",
    "@wagmi/connectors": "^5.7.4",
    "@wagmi/core": "^2.16.7",
    "audio-recorder-polyfill": "^0.4.1",
    "extendable-media-recorder": "^9.2.11",
    "extendable-media-recorder-wav-encoder": "^7.0.115",
    "ic-siwe-js": "^0.2.4",
    "viem": "^2.23.13",
    "vite-plugin-top-level-await": "^1.4.4",
    "vite-plugin-wasm": "^3.3.0",
    "wagmi": "^2.14.15"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.5.26",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@tsconfig/svelte": "^5.0.4",
    "@types/node": "^22.10.2",
    "autoprefixer": "^10.4.20",
    "cross-fetch": "^4.0.0",
    "dotenv": "^16.4.5",
    "jsdom": "^25.0.0",
    "postcss": "^8.4.45",
    "prettier": "^3.2.5",
    "prettier-plugin-svelte": "^3.2.1",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "sass": "^1.78.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.1",
    "svelte-preprocess": "^6.0.2",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.6.2",
    "vite": "^5.4.4",
    "vite-plugin-environment": "^1.1.3",
    "vitest": "^2.0.5"
  }
}
