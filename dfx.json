  "canisters": {
    "internet_identity": {
      "candid": "https://github.com/dfinity/internet-identity/releases/latest/download/internet_identity.did",
      "frontend": {},
      "remote": {
        "id": {
          "ic": "rdmx6-jaaaa-aaaaa-aaadq-cai"
        }
      },
      "type": "custom",
      "wasm": "https://github.com/dfinity/internet-identity/releases/latest/download/internet_identity_dev.wasm.gz"
    },
    "voice_among_voices_backend": {
      "candid": "src/voice_among_voices_backend/voice_among_voices_backend.did",
      "declarations": {
        "node_compatibility": true
      },
      "package": "voice_among_voices_backend",
      "type": "rust"
    },
    "voice_among_voices_frontend": {
      "dependencies": [
        "voice_among_voices_backend"
      ],
      "source": [
        "src/voice_among_voices_frontend/dist"
      ],
      "type": "assets",
      "workspace": "voice_among_voices_frontend"
    },
    "ic_siwe_provider": {
      "type": "custom",
      "candid": "https://github.com/kristoferlund/ic-siwe/releases/download/v0.0.6/ic_siwe_provider.did",
      "wasm": "https://github.com/kristoferlund/ic-siwe/releases/download/v0.0.6/ic_siwe_provider.wasm.gz",
      "init_arg": "(record { domain = \"127.0.0.1\"; uri = \"http://127.0.0.1:5173\"; salt = \"my secret salt\"; chain_id = opt 1; scheme = opt \"http\"; statement = opt \"Login to the app\"; sign_in_expires_in = opt 300000000000; session_expires_in = opt 604800000000000; targets = opt vec {\"'$(dfx canister id ic_siwe_provider)'\"; \"'$(dfx canister id voice_among_voices_frontend)'\";};})"
    }
  },
  "defaults": {
    "build": {
      "args": "",
